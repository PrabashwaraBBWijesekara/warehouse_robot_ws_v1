<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="warehouse_robot">

  <xacro:property name="base_x" value="0.70"/>
  <xacro:property name="base_y" value="0.50"/>
  <xacro:property name="base_z" value="0.12"/>
  <xacro:property name="base_mass" value="18.0"/>
  <xacro:property name="base_clearance" value="0.03"/>  <!-- ground to chassis underside -->
  <xacro:property name="wheel_radius" value="0.075"/>
  <xacro:property name="wheel_width" value="0.05"/>
  <xacro:property name="wheel_y" value="0.28"/>
  <xacro:property name="wheel_mass" value="1.5"/>
  <xacro:property name="caster_radius" value="0.04"/>
  <xacro:property name="caster_x" value="0.28"/>
  <xacro:property name="caster_mass" value="0.3"/>

  <material name="body_blue"><color rgba="0.2 0.28 0.45 1"/></material>
  <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
  <material name="dark_grey"><color rgba="0.25 0.25 0.27 1"/></material>

  <!-- Frame on the ground -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- The chassis. base_link is at axle height, so the box is offset from it. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_clearance + base_z/2 - wheel_radius}"/>
      <geometry><box size="${base_x} ${base_y} ${base_z}"/></geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_clearance + base_z/2 - wheel_radius}"/>
      <geometry><box size="${base_x} ${base_y} ${base_z}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${base_clearance + base_z/2 - wheel_radius}"/>
      <mass value="${base_mass}"/>
      <!-- solid box: ixx = m/12 (y² + z²), iyy = m/12 (x² + z²), izz = m/12 (x² + y²) -->
      <inertia ixx="${base_mass/12.0*(base_y*base_y + base_z*base_z)}" ixy="0" ixz="0"
               iyy="${base_mass/12.0*(base_x*base_x + base_z*base_z)}" iyz="0"
               izz="${base_mass/12.0*(base_x*base_x + base_y*base_y)}"/>
    </inertial>
  </link>

  <!-- Drive wheel: one definition, used for left and right -->
  <xacro:macro name="drive_wheel" params="side y">
    <link name="${side}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <!-- solid cylinder spinning about Y:
             iyy = m r²/2,  ixx = izz = m/12 (3 r² + h²) -->
        <inertia ixx="${wheel_mass/12.0*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
                 ixy="0" ixz="0"
                 iyy="${wheel_mass*wheel_radius*wheel_radius/2.0}"
                 iyz="0"
                 izz="${wheel_mass/12.0*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"/>
      </inertial>
    </link>

    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="40.0" velocity="20.0"/>
      <dynamics damping="0.01" friction="0.0"/>
    </joint>

    <gazebo reference="${side}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:drive_wheel side="left"  y="${wheel_y}"/>
  <xacro:drive_wheel side="right" y="${-wheel_y}"/>
</robot>